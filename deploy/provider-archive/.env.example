ARCHIVE_POSTGRES_PASSWORD=
# URL-encode the password. Use the isolated center database, never the project DB.
PROVIDER_ARCHIVE_DATABASE_URL=
# Absolute path on the Docker host; contains token hashes, not provider keys.
PROVIDER_ARCHIVE_CREDENTIALS_FILE=
PROVIDER_ARCHIVE_PORT=7400
PROVIDER_ARCHIVE_HTTP_BODY_LIMIT=50331648
