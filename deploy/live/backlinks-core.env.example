BACKLINKS_RUNTIME_MODULE=C:\absolute\path\to\backend\core\dist\modules\backlinks\runtime\production-runtime.js

DATABASE_URL_SECRET_REF=secret://growthos/canary/backlinks/database-url
DATABASE_URL_FILE=C:\run\secrets\backlinks-database-url
# The mounted value must identify a LOGIN, NOSUPERUSER, NOBYPASSRLS principal
# that is a member of growthos_backlinks_writer.
BACKLINK_DB_STATEMENT_TIMEOUT_MS=5000
BACKLINK_DB_LOCK_TIMEOUT_MS=2000
BACKLINK_DB_POOL_MAX=10
BACKLINK_DB_IDLE_TIMEOUT_MS=30000
BACKLINK_DB_CONNECT_TIMEOUT_MS=5000

TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_NAMESPACE=growthos-backlinks-canary
TEMPORAL_BACKLINKS_TASK_QUEUE=growthos.backlinks.v1
TEMPORAL_BUILD_ID=backlinks-2026.07.31.1

BACKLINKS_API_ENABLED=true
BACKLINKS_WORKER_ENABLED=false
BACKLINK_API_BODY_LIMIT=1048576
BACKLINK_API_REQUEST_TIMEOUT_MS=15000
BACKLINKS_HOST=127.0.0.1
BACKLINKS_PORT=7301

PLATFORM_CONTEXT_SIGNING_KEY_SECRET_REF=secret://growthos/canary/platform-context-signing-key
PLATFORM_CONTEXT_SIGNING_KEY_FILE=C:\run\secrets\platform-context-signing-key

GMAIL_SEND_ENABLED=false
GMAIL_SYNC_ENABLED=false
DATAFORSEO_ENABLED=false
AI_PROVIDER_ENABLED=false
BROWSER_PROVIDER_ENABLED=false
