APP_ENV=production
APP_NAME=SEO API
API_PREFIX=/api/v1
API_HOST=0.0.0.0
API_PORT=7200
API_WORKERS=1
API_LOG_LEVEL=info
CORS_ORIGINS=["https://canary.example.invalid"]

DATABASE_URL_SECRET_REF=secret://growthos/canary/platform-database-url
DATABASE_URL_FILE=C:\run\secrets\platform-database-url

REDIS_URL=redis://127.0.0.1:6379/0
TEMPORAL_ADDRESS=127.0.0.1:7233
BACKLINKS_PRIVATE_BASE_URL=http://127.0.0.1:7301
BACKLINKS_REQUEST_TIMEOUT_SECONDS=5
RUNTIME_DEPENDENCY_CHECKS_ENABLED=true
RUNTIME_DEPENDENCY_TIMEOUT_SECONDS=5

PLATFORM_AUTH_ISSUER=growthos-platform-auth
PLATFORM_AUTH_MAX_TOKEN_TTL_SECONDS=900
PLATFORM_AUTH_SIGNING_KEY_SECRET_REF=secret://growthos/canary/platform-auth-signing-key
PLATFORM_AUTH_SIGNING_KEY_FILE=C:\run\secrets\platform-auth-signing-key
PLATFORM_CONTEXT_SIGNING_KEY_SECRET_REF=secret://growthos/canary/platform-context-signing-key
PLATFORM_CONTEXT_SIGNING_KEY_FILE=C:\run\secrets\platform-context-signing-key

GMAIL_SEND_ENABLED=false
GMAIL_SYNC_ENABLED=false
DATAFORSEO_ENABLED=false
AI_PROVIDER_ENABLED=false
BROWSER_PROVIDER_ENABLED=false
