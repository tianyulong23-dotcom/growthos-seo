{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://growthos.local/contracts/platform-access-token.v1.schema.json",
  "title": "PlatformAccessToken.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "issuer",
    "audience",
    "issuedAt",
    "expiresAt",
    "actor",
    "memberships"
  ],
  "properties": {
    "version": {
      "const": "PlatformAccessToken.v1"
    },
    "issuer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "audience": {
      "const": "growthos-platform-gateway"
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": "string",
      "format": "date-time"
    },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "userId",
        "sessionId"
      ],
      "properties": {
        "userId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      }
    },
    "memberships": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "organizationId",
          "workspaceId",
          "roles",
          "projectIds",
          "permissions"
        ],
        "properties": {
          "organizationId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "workspaceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "roles": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "projectIds": {
            "type": "array",
            "minItems": 1,
            "maxItems": 256,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            }
          },
          "permissions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 128,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_.-]*:[a-z][a-z0-9_.-]*$"
            }
          }
        }
      }
    }
  }
}
