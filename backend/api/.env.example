APP_ENV=development
APP_NAME=SEO API
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/seo
REDIS_URL=redis://localhost:6379/0
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
CRAWLER_TASK_QUEUE=crawler-go
CRAWLER_WORKER_EXECUTABLE=
CRAWLER_WORKER_IDLE_TIMEOUT_SECONDS=120
CRAWLER_DATABASE_URL=
CRAWLER_BROWSER_CACHE_DIR=
CRAWLER_USER_AGENT=
CRAWLER_ROBOTS_USER_AGENT=SEOPlatformBot
CRAWLER_REQUEST_DELAY=250ms
CRAWLER_RANDOM_DELAY=150ms
CRAWLER_STATUS_REQUEST_DELAY=50ms
CRAWLER_STATUS_RANDOM_DELAY=50ms
CRAWLER_HTTP_CONCURRENCY=5
CRAWLER_STATUS_CONCURRENCY=5
CRAWLER_BROWSER_CONCURRENCY=3
CRAWLER_RESOURCE_CHECK_LIMIT=50000
CRAWLER_PROXY_URL=
CRAWLER_FALLBACK_PROXY_URL=
BUSINESS_PROFILE_AI_BASE_URL=
BUSINESS_PROFILE_AI_API_KEY=
BUSINESS_PROFILE_AI_MODEL=gpt-5.4-mini
BUSINESS_PROFILE_AI_TIMEOUT=90s
BUSINESS_PROFILE_AI_MAX_RETRIES=1
AI_SETTINGS_ENCRYPTION_KEY=
SITE_UNDERSTANDING_REQUEST_TIMEOUT=12s
SITE_UNDERSTANDING_MAX_RETRIES=2
SITE_UNDERSTANDING_DISPATCH_INTERVAL_SECONDS=5
DEFAULT_ORGANIZATION_ID=local
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=seo-crawler
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_USE_PATH_STYLE=true
S3_CREATE_BUCKET=true
