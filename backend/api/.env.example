APP_ENV=development
APP_NAME=SEO API
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173"]
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/seo
REDIS_URL=redis://localhost:6379/0
TEMPORAL_ADDRESS=localhost:7233
S3_ENDPOINT_URL=http://localhost:9000
BACKLINKS_PRIVATE_BASE_URL=http://127.0.0.1:7301
BACKLINKS_REQUEST_TIMEOUT_SECONDS=5
# PLATFORM_AUTH_SIGNING_KEY=resolve-from-auth-secret-manager
PLATFORM_AUTH_ISSUER=growthos-platform-auth
PLATFORM_AUTH_MAX_TOKEN_TTL_SECONDS=900
# PLATFORM_CONTEXT_SIGNING_KEY=resolve-from-secret-manager
