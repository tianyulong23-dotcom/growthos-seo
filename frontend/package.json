{
  "name": "seo-frontend",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:backlinks-client": "node scripts/generate-backlinks-client.mjs",
    "check:backlinks-client": "node scripts/generate-backlinks-client.mjs --check",
    "check:backlinks-v2-contract": "tsc -p tsconfig.backlinks-v2-contract.json --noEmit --incremental false",
    "test": "vitest run",
    "test:project-authority-source": "node --test src/features/projects/project-authority-source.test.mjs",
    "test:outreach-source": "node --test src/runtime-status-source.test.mjs src/features/outreach/drafts/draft-editor-source.test.mjs src/features/outreach/drafts/draft-read-contract.test.mjs src/features/outreach/gmail/gmail-auth-foundation-source.test.mjs src/features/outreach/gmail/gmail-source.test.mjs src/features/outreach/links/links-source.test.mjs src/features/outreach/mail/mail-center-source.test.mjs src/features/outreach/reports/reports-source.test.mjs src/features/outreach/settings/settings-source.test.mjs",
    "test:e2e:desktop": "playwright test test/outreach-desktop.spec.ts --project=desktop-chromium",
    "test:e2e:backlinks": "playwright test test/recommendation-feed-phase6.spec.ts test/recommendation-feed-phase7.spec.ts --project=desktop-chromium --project=mobile-chromium",
    "test:e2e:keyboard-a11y": "playwright test test/outreach-keyboard-a11y.spec.ts --project=desktop-chromium",
    "test:e2e:mobile": "playwright test test/outreach-mobile.spec.ts --project=mobile-chromium",
    "typecheck": "tsc --noEmit",
    "preview": "vite preview"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@fontsource-variable/inter": "^5.2.8",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.101.4",
    "@tiptap/extension-bubble-menu": "3.28.0",
    "@tiptap/extension-code-block-lowlight": "3.28.0",
    "@tiptap/extension-drag-handle-react": "3.28.0",
    "@tiptap/extension-file-handler": "3.28.0",
    "@tiptap/extension-highlight": "^3.28.0",
    "@tiptap/extension-link": "3.28.0",
    "@tiptap/extension-table": "3.28.0",
    "@tiptap/extension-text-align": "3.28.0",
    "@tiptap/react": "3.28.0",
    "@tiptap/starter-kit": "3.28.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cytoscape": "^3.34.0",
    "hash-wasm": "4.12.0",
    "lowlight": "3.3.0",
    "lucide-react": "^1.25.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-markdown": "^10.1.0",
    "react-router": "^8.2.0",
    "recharts": "^3.8.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "shadcn": "^4.13.0",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.12.1",
    "@eslint/js": "^10",
    "@playwright/test": "^1.62.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "@tiptap/core": "3.28.0",
    "@tiptap/extension-blockquote": "3.28.0",
    "@tiptap/extension-bold": "3.28.0",
    "@tiptap/extension-bubble-menu": "3.28.0",
    "@tiptap/extension-bullet-list": "3.28.0",
    "@tiptap/extension-code": "3.28.0",
    "@tiptap/extension-code-block": "3.28.0",
    "@tiptap/extension-document": "3.28.0",
    "@tiptap/extension-dropcursor": "3.28.0",
    "@tiptap/extension-floating-menu": "3.28.0",
    "@tiptap/extension-gapcursor": "3.28.0",
    "@tiptap/extension-hard-break": "3.28.0",
    "@tiptap/extension-heading": "3.28.0",
    "@tiptap/extension-horizontal-rule": "3.28.0",
    "@tiptap/extension-italic": "3.28.0",
    "@tiptap/extension-link": "3.28.0",
    "@tiptap/extension-list": "3.28.0",
    "@tiptap/extension-list-item": "3.28.0",
    "@tiptap/extension-list-keymap": "3.28.0",
    "@tiptap/extension-ordered-list": "3.28.0",
    "@tiptap/extension-paragraph": "3.28.0",
    "@tiptap/extension-strike": "3.28.0",
    "@tiptap/extension-text": "3.28.0",
    "@tiptap/extension-underline": "3.28.0",
    "@tiptap/extensions": "3.28.0",
    "@tiptap/pm": "3.28.0"
  }
}
